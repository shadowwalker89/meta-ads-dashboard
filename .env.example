# Auth provider selection. Placeholders only — never commit real
# credentials. In production AUTH_PROVIDER MUST be "supabase"; the app
# refuses to fall back to mock in production.
AUTH_PROVIDER=mock

# Supabase (deployment phase) — anon key only, never the service role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Demo VPS only — NEVER enable this on a real production deployment
# ALLOW_MOCK_IN_PRODUCTION=true