# Authentication provider selection. This is independent from DATABASE_PROVIDER.
# In production AUTH_PROVIDER MUST be "supabase"; the app refuses to fall back
# to mock authentication unless the explicit demo-only override is enabled.
AUTH_PROVIDER=mock

# Database provider selection. Defaults to sqlite when omitted.
DATABASE_PROVIDER=sqlite

# Supabase Auth — anon key only, never the service role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Demo VPS only — NEVER enable this on a real production deployment
# ALLOW_MOCK_IN_PRODUCTION=true